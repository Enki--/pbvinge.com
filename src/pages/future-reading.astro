---
import Layout from '../layouts/Layout.astro';
import { getFutureReads } from '../data/future-reads';
import '../css/tables.css';
const futureReads = await getFutureReads();
---

<Layout title="Future Reading - Shrink">
  <div class="future-reading">
    <header>
      <h1>Future Reading</h1>
      <p>Books in progress and planned reading, organized by reading list.</p>
    </header>
    <div class="filters">
      <label for="filterInput">Search future reading</label>
      <input type="search" id="filterInput" placeholder="Search titles, authors, lists, or tags" />
      <p id="filterCount" role="status">{futureReads.length} books</p>
    </div>
    <div class="pbv-table-wrapper">
      <table class="pbv-table">
        <caption class="sr-only">Published reading and planned books</caption>
        <thead>
          <tr>
            <th scope="col" class="pbv-col-cover">Cover</th>
            {(['title', 'author', 'class', 'status'] as const).map((key) => (
              <th scope="col" data-sort={key} aria-sort="none">
                <button type="button" class="sort-button" data-sort-button>
                  {{title: 'Title', author: 'Author', class: 'List', status: 'Status'}[key]}
                  <span class="pbv-sort-icon" aria-hidden="true">↕</span>
                </button>
              </th>
            ))}
          </tr>
        </thead>
        <tbody id="tableBody">
          {futureReads.map((book) => (
            <tr data-title={book.title} data-author={book.author.join(', ')} data-class={book.class} data-status={book.status}
                data-search={[book.title, book.author.join(' '), book.class, book.status, book.tags.join(' '), book.notes].join(' ').toLowerCase()}>
              <td class="pbv-col-cover"><img src={book.coverImage} alt={`Cover of ${book.title}`} class="pbv-table-cover" loading="lazy" /></td>
              <td><strong>{book.title}</strong>{book.notes && <p>{book.notes}</p>}</td>
              <td>{book.author.join(', ')}</td>
              <td>{book.class || '—'}</td>
              <td>{book.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Layout>
<style>
  .future-reading { width: min(100%, 1100px); margin: auto; padding: 2rem var(--gutter); min-width: 0; }
  header { text-align: center; margin-bottom: 2rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  header p { color: var(--text-subtle); }
  .filters { max-width: 36rem; margin: 0 auto 1rem; }
  label { display: block; margin-bottom: .4rem; }
  input { width: 100%; padding: .75rem; border: 1px solid var(--border-light); border-radius: .5rem; background: var(--background-color); color: var(--text-color); }
  #filterCount { color: var(--text-subtle); margin-top: .5rem; }
  .pbv-table-wrapper { overflow-x: auto; }
  .pbv-table { min-width: 680px; }
  .sort-button { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: .25rem; }
  .sort-button:focus-visible { outline: 2px solid var(--link-color); outline-offset: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  [hidden] { display: none !important; }
</style>
<script type="module" src="/scripts/future-reading.js"></script>
