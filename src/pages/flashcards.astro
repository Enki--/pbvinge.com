---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { isPublishedBookNote } from '../utils/books';
import { buildNoteFlashcard, type NoteFlashcard } from '../utils/flashcards';

const books = await getCollection('books', ({ data }) => isPublishedBookNote(data));
const cards = books.sort((a, b) => a.data.title.localeCompare(b.data.title) || a.id.localeCompare(b.id))
  .map(buildNoteFlashcard).filter((card): card is NoteFlashcard => card !== null);
// Exact source units remain on the server; the client only receives displayed text.
const displayedCards = cards.map(({ ideas, ...card }) => ({
  ...card, ideas: ideas.map(({ text, section }) => ({ text, section })),
}));
const first = displayedCards[0];
const cardsJson = JSON.stringify(displayedCards).replace(/</g, '\\u003C');
---

<Layout title="Flashcards - Shrink">
  <section class="deck" aria-labelledby="deckTitle">
    <header class="deck-header">
      <h1 id="deckTitle">Flashcards</h1>
      <p>Recall two ideas from each published book note.</p>
      <p class="source-note">Excerpts come from the study notes. Follow the source to read their context and references.</p>
    </header>
    <div class="stack">
      <article class="card" aria-labelledby="cardTitle">
        <div class="card-meta">
          <span id="eyebrow">Recall</span>
          <span id="progress" role="status">{first ? `1 / ${cards.length}` : '0 / 0'}</span>
        </div>
        <h2 id="cardTitle">{first?.title || 'No published notes available'}</h2>
        <p id="cardAuthor">{first?.credit || ''}</p>
        <div id="cardFront">
          {first?.img && <img id="cardImage" src={first.img} alt={`Cover of ${first.title}`} loading="lazy" />}
          <p>Which two ideas do these study notes emphasize?</p>
        </div>
        <div id="cardBack" hidden inert>
          <h3>Ideas from the note</h3>
          <ul id="cardIdeas">
            {first?.ideas.map(idea => <li><p>{idea.text}</p><small>From: {idea.section || 'Study notes'}</small></li>)}
          </ul>
        </div>
        <button id="toggleBtn" type="button" aria-expanded="false" aria-controls="cardBack" disabled={!first}>Show ideas</button>
        <a id="sourceLink" href={first?.sourceHref || '/books'}>Read the source note</a>
        <a id="issueLink" class="issue-link" href="https://github.com/Enki--/pbvinge.com/issues/new" target="_blank" rel="noreferrer noopener">Suggest an edit on GitHub</a>
      </article>
      <div class="controls" role="group" aria-label="Flashcard navigation">
        <button id="prevBtn" type="button" disabled={!first}>← Previous card</button>
        <button id="nextBtn" type="button" disabled={!first}>Next card →</button>
      </div>
    </div>
    <p class="hint">Use the buttons with Enter or Space. Left and right arrows move between cards when a deck button has focus.</p>
    <noscript><p>The first card is shown above. Enable JavaScript to reveal ideas and browse the full deck, or <a href="/books">read the book notes</a>.</p></noscript>
  </section>
  <script id="flashcards-data" type="application/json" set:html={cardsJson}></script>
</Layout>

<style>
  .deck { min-height: 70vh; padding: clamp(1rem, 3vw, 3rem); display: grid; justify-items: center; gap: 1.5rem; }
  .deck-header { text-align: center; max-width: 45rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .source-note, .hint { color: var(--text-subtle); }
  .stack { width: min(100%, 45rem); display: grid; gap: 1rem; min-width: 0; }
  .card { border: 1px solid var(--border-light); border-radius: 1rem; padding: clamp(1rem, 3vw, 2rem); background: var(--background-color); display: grid; gap: 1rem; }
  .card-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--text-subtle); }
  h2 { font-size: clamp(1.3rem, 4vw, 1.8rem); overflow-wrap: anywhere; }
  #cardAuthor { color: var(--text-subtle); }
  #cardFront { text-align: center; }
  #cardImage { max-width: min(100%, 240px); max-height: 330px; object-fit: contain; margin: 0 auto 1rem; border-radius: .5rem; }
  #cardIdeas { padding-left: 1.25rem; line-height: 1.6; }
  #cardIdeas :global(li + li) { margin-top: 1rem; }
  #cardIdeas :global(small) { color: var(--text-subtle); }
  .controls { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; }
  button { border: 1px solid var(--border-light); border-radius: .5rem; padding: .65rem 1rem; background: var(--surface-subtle); color: var(--text-color); cursor: pointer; }
  button:disabled { opacity: .6; cursor: default; }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--link-color); outline-offset: 3px; }
  a { color: var(--link-color); text-decoration: underline; overflow-wrap: anywhere; }
  .hint { max-width: 45rem; text-align: center; font-size: .9rem; }
  [hidden] { display: none !important; }
</style>
<script>
  import { initFlashcards } from '../utils/flashcards-client';
  initFlashcards();
</script>
