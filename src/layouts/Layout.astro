---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Shrink's personal website" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <title>{title}</title>
    <script is:inline>
      (function() {
        try {
          const storedTheme = window.localStorage.getItem('site-theme');
          const theme = storedTheme || 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (err) {
          console.warn('Unable to load theme preference', err);
        }
      })();
    </script>
  </head>
  <body>
    <nav aria-label="Main navigation">
      <div class="nav-content">
        <a href="/" class="home-link">Shrink</a>
        <div class="nav-links">
          <details class="nav-menu" data-nav-menu>
            <summary>Reading</summary>
            <div class="nav-menu-panel">
              <a href="/books">Books</a>
              <a href="/future-reading">Future Reading</a>
              <a href="/historic-documents">Historic Documents</a>
              <a href="/notes">Notes</a>
            </div>
          </details>
          <details class="nav-menu" data-nav-menu>
            <summary>History</summary>
            <div class="nav-menu-panel">
              <a href="/timeline">Timeline</a>
              <a href="/presidents">Presidents</a>
              <a href="/aircraft-of-the-91st">Aircraft of the 91st</a>
              <a href="/archives/91st">91st Archives</a>
            </div>
          </details>
          <details class="nav-menu" data-nav-menu>
            <summary>Tools</summary>
            <div class="nav-menu-panel">
              <a href="/flashcards">Flashcards</a>
              <a href="/comps">Comps</a>
              <a href="/17x-ribbon-chart">17X Ribbon Chart</a>
              <a href="/17x-join-spouse">Join Spouse Planner</a>
            </div>
          </details>
          <a href="/about" class="nav-standalone">About</a>
        </div>
      </div>
    </nav>
    <script is:inline>
      (() => {
        const menus = Array.from(document.querySelectorAll('[data-nav-menu]'));
        menus.forEach((menu) => {
          menu.addEventListener('toggle', () => {
            if (!menu.open) return;
            menus.forEach((candidate) => {
              if (candidate !== menu) candidate.open = false;
            });
          });
        });
        document.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('[data-nav-menu]')) return;
          menus.forEach((menu) => { menu.open = false; });
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') menus.forEach((menu) => { menu.open = false; });
        });
      })();
    </script>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --text-color: #1f2933;
    --muted-text: #6b7280;
    --text-subtle: #666;
    --text-strong: #374151;
    --background-color: #ffffff;
    --surface-color: #ffffff;
    --surface-subtle: #f3f4f6;
    --surface-soft: #f5f5f5;
    --surface-chip: #f0f0f0;
    --surface-muted-color: #f4f6fb;
    --chip-background: #edf1f7;
    --chip-text: #374151;
    --border-color: #e5e7eb;
    --border-light: #e5e7eb;
    --border-lighter: #e5e5e5;
    --hover-row: #f8fafc;
    --blockquote-bg: #f4f4f5;
    --blockquote-border: #d1d5db;
    --link-color: #2563eb;
    --space-1: 0.5rem;
    --space-2: 1rem;
    --space-3: 1.5rem;
    --space-4: 2rem;
    --space-5: 3rem;
    --gutter: clamp(1rem, 4vw, 2.5rem);
    --max-width: 1200px;
    --page-max-width: 1200px;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --text-color: #e2e8f0;
    --muted-text: #94a3b8;
    --text-subtle: #94a3b8;
    --text-strong: #e2e8f0;
    --background-color: #0f172a;
    --surface-color: #111c2e;
    --surface-subtle: #0f172a;
    --surface-soft: rgba(148, 163, 184, 0.2);
    --surface-chip: rgba(148, 163, 184, 0.2);
    --surface-muted-color: #18213a;
    --chip-background: rgba(148, 163, 184, 0.25);
    --chip-text: #e2e8f0;
    --border-color: #243354;
    --border-light: #1f2a44;
    --border-lighter: #1f2a44;
    --hover-row: #0b1220;
    --blockquote-bg: rgba(148, 163, 184, 0.18);
    --blockquote-border: #334155;
    --link-color: #93c5fd;
  }

  * {
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.6;
    color: var(--text-color);
    background: var(--background-color);
    margin: 0;
    padding: 0;
  }

  nav {
    padding: var(--space-3) var(--gutter);
    border-bottom: 1px solid var(--border-color);
    background: var(--background-color);
  }

  .nav-content {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
  }

  .home-link {
    font-weight: 600;
    text-decoration: none;
    color: var(--text-color);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .nav-links a,
  .nav-menu summary {
    text-decoration: none;
    color: var(--text-color);
  }

  .nav-menu {
    position: relative;
  }

  .nav-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 8px;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    list-style: none;
    user-select: none;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu summary::after {
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    content: "";
    transform: translateY(-0.12rem) rotate(45deg);
    transition: transform 160ms ease;
  }

  .nav-menu[open] summary::after {
    transform: translateY(0.1rem) rotate(225deg);
  }

  .nav-menu summary:hover,
  .nav-menu summary:focus-visible,
  .nav-menu[open] summary,
  .nav-standalone:hover,
  .nav-standalone:focus-visible {
    background: var(--surface-muted-color);
    outline: none;
    text-decoration: none;
  }

  .nav-menu-panel {
    position: absolute;
    top: calc(100% + 0.45rem);
    right: 0;
    z-index: 50;
    display: grid;
    min-width: 13.5rem;
    gap: 0.15rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface-color);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
    padding: 0.45rem;
  }

  .nav-menu-panel a {
    display: block;
    border-radius: 6px;
    padding: 0.45rem 0.55rem;
    white-space: nowrap;
  }

  .nav-menu-panel a:hover,
  .nav-menu-panel a:focus-visible {
    background: var(--surface-muted-color);
    outline: none;
    text-decoration: none;
  }

  .nav-standalone {
    border-radius: 8px;
    padding: 0.35rem 0.6rem;
    font-weight: 600;
  }

  a {
    color: var(--link-color);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .pbv-text-strong {
    color: var(--text-strong);
  }

  .pbv-text-subtle {
    color: var(--text-subtle);
  }

  .pbv-tag {
    background: var(--surface-chip);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    color: var(--text-subtle);
  }

  h1, h2, h3 {
    line-height: 1.3;
  }

  .site-main {
    width: 100%;
    margin: 0 auto;
    padding: var(--space-4) var(--gutter);
    max-width: var(--page-max-width);
  }

  /* Mobile-friendly header */
  @media (max-width: 640px) {
    nav { padding: var(--space-2) var(--gutter); }
    .nav-content {
      flex-direction: column;
      gap: var(--space-1);
    }
    .nav-links {
      display: grid;
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: center;
      gap: 0.5rem;
    }
    .nav-menu,
    .nav-standalone {
      min-width: 0;
    }
    .nav-menu summary,
    .nav-standalone {
      display: flex;
      min-height: 2.4rem;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-color);
      background: var(--surface-color);
      font-size: 0.95rem;
    }
    .nav-menu[open] {
      grid-column: 1 / -1;
    }
    .nav-menu-panel {
      position: static;
      margin-top: 0.45rem;
      box-shadow: none;
    }
    .nav-menu-panel a {
      text-align: center;
      white-space: normal;
    }
  }
</style>
